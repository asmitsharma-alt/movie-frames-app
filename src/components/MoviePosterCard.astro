---
import type { MovieInfo } from '../lib/types';

interface Props {
  movie: MovieInfo;
  index: number;
}

const { movie } = Astro.props;
---

<a 
  href={`/movie/${movie.tmdbId}`}
  class="group block h-full focus:outline-none focus-visible:ring-2 focus-visible:ring-black dark:focus-visible:ring-white rounded-none"
>
  <!-- Neo-Brutalist Solid Card with Hard Offset Shadow -->
  <div class="brutal-card brutal-card-hover p-2.5 sm:p-3 rounded-none h-full flex flex-col justify-between">
    
    <!-- 2:3 Ratio Movie Poster with Heavy Border -->
    <div class="aspect-[2/3] overflow-hidden bg-black relative border-2 border-black dark:border-white">
      <img 
        src={movie.posterUrl || 'https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=500&q=80'} 
        alt={`${movie.title} Poster`} 
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-200 ease-out"
      />
      
      <!-- Minimal Editorial Tag Overlay on Hover -->
      <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-150 flex items-end p-2.5">
        <span class="w-full text-center py-1.5 px-2 bg-dynamic-accent font-mono font-black text-xs uppercase border-2 border-black tracking-wider">
          VIEW FRAMES →
        </span>
      </div>
    </div>

    <!-- Editorial Title & Monospace Year (Clean & Minimal) -->
    <div class="pt-2.5 px-0.5">
      <h3 class="font-bold text-xs sm:text-sm uppercase tracking-tight text-black dark:text-white line-clamp-1 group-hover:underline">
        {movie.title}
      </h3>
      <p class="font-mono text-[11px] font-bold text-zinc-600 dark:text-zinc-400 mt-0.5">
        {movie.year}
      </p>
    </div>

  </div>
</a>
