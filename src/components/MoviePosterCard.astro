---
import type { MovieInfo } from '../lib/types';

interface Props {
  movie: MovieInfo;
  index: number;
}

const { movie, index } = Astro.props;

// Natural physical tilts for scrapbook lobby cards
const rotations = ['-rotate-1', 'rotate-1.5', '-rotate-2', 'rotate-1', '-rotate-1.5', 'rotate-2'];
const rotationClass = rotations[index % rotations.length];
---

<a 
  href={`/movie/${movie.tmdbId}`}
  class="relative group block"
>
  <!-- Washi tape at the top -->
  <div class="washi-tape"></div>

  <!-- Polaroid Lobby Card -->
  <div class={`polaroid-card rounded-xs transform ${rotationClass} transition-all duration-300 group-hover:rotate-0 group-hover:-translate-y-2 group-hover:shadow-2xl`}>
    
    <!-- 2:3 Movie Poster Frame -->
    <div class="aspect-[2/3] overflow-hidden bg-stone-900 relative rounded-xs border border-stone-200 dark:border-stone-800">
      <img 
        src={movie.posterUrl || 'https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=500&q=80'} 
        alt={`${movie.title} Poster`} 
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
        <span class="font-mono text-xs text-white uppercase tracking-wider bg-stone-900/90 px-3 py-1.5 border border-white/20">
          🎞 Click to View Frames →
        </span>
      </div>
    </div>

    <!-- Poster Card Chin -->
    <div class="pt-3 pb-1 text-stone-900 dark:text-stone-900">
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-serif text-lg font-bold tracking-tight leading-tight line-clamp-1 group-hover:text-amber-900 transition-colors">
          {movie.title}
        </h3>
        <span class="font-mono text-xs text-stone-500 font-bold whitespace-nowrap">
          {movie.year}
        </span>
      </div>

      <div class="mt-2 pt-2 border-t border-stone-200 flex items-center justify-between font-mono text-[10px] text-stone-600">
        <span>TMDB #{movie.tmdbId}</span>
        <span class="stamp-badge px-1.5 py-0.5 border-stone-400 group-hover:border-stone-900 group-hover:bg-stone-900 group-hover:text-white transition-colors">
          VIEW FRAMES
        </span>
      </div>
    </div>

  </div>
</a>
