---
import Layout from '../layouts/Layout.astro';
import PolaroidCard from '../components/PolaroidCard.astro';
import MoviePosterCard from '../components/MoviePosterCard.astro';
import { getFramesForMovie } from '../lib/storage';
import { getTmdbMovieDetails, searchTmdbMovies, getTmdbMovieBackdrops } from '../lib/tmdb';
import { getAppEnv } from '../lib/env';

export const prerender = false;

const searchQuery = Astro.url.searchParams.get('q')?.trim();
const currentId = Astro.url.searchParams.get('id') || '157336';
const appEnv = getAppEnv();
const apiKey = appEnv?.TMDB_API_KEY || (typeof process !== 'undefined' ? process.env?.TMDB_API_KEY : undefined);

// 1. If searching, fetch movie poster search results from TMDB
const searchResults = searchQuery ? await searchTmdbMovies(searchQuery, apiKey) : null;

// 2. If not searching, fetch the active movie and its frames
const [movie, userFrames] = await Promise.all([
  getTmdbMovieDetails(currentId, apiKey),
  getFramesForMovie(currentId)
]);

// If no community frames exist yet, use official TMDB film stills as initial frames
let frames = userFrames;
if (frames.length === 0) {
  frames = await getTmdbMovieBackdrops(currentId, apiKey);
}

const featuredMovies = [
  { id: '157336', title: 'Interstellar', year: '2014' },
  { id: '335984', title: 'Blade Runner 2049', year: '2017' },
  { id: '62', title: '2001: A Space Odyssey', year: '1968' },
  { id: '438631', title: 'Dune', year: '2021' },
  { id: '27205', title: 'Inception', year: '2010' },
  { id: '872585', title: 'Oppenheimer', year: '2023' }
];
---

<Layout title={searchQuery ? `Search: "${searchQuery}" — Archive.Frame` : `${movie.title} (${movie.year}) — Film Stills Archive`}>
  
  {searchQuery ? (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-16">
      
      <!-- Search Header Glass Card -->
      <div class="glass-card rounded-3xl p-6 sm:p-8 mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6 border border-white/80 dark:border-white/10">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <a href="/" class="text-xs font-medium text-zinc-500 hover:text-zinc-900 dark:hover:text-white flex items-center gap-1 transition-colors">
              <span>←</span>
              <span>Back to Archive</span>
            </a>
            <span class="text-zinc-300 dark:text-zinc-700">•</span>
            <span class="glass-pill text-[10px] font-mono px-2 py-0.5 rounded-full text-blue-600 dark:text-blue-400 font-semibold">
              LIVE SEARCH
            </span>
          </div>
          
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            Results for <span class="text-blue-600 dark:text-blue-400 font-medium">"{searchQuery}"</span>
          </h1>

          {searchResults && searchResults.length > 0 && searchResults[0].title.toLowerCase() !== searchQuery.toLowerCase() && (
            <div class="inline-flex items-center gap-2 mt-3 px-3 py-1.5 rounded-xl bg-blue-50/80 dark:bg-blue-950/40 border border-blue-200/70 dark:border-blue-800/40 text-xs text-blue-900 dark:text-blue-300 font-mono">
              <span class="text-blue-500 font-bold">✦</span>
              <span>Typo auto-match: Top result is <strong>{searchResults[0].title}</strong> ({searchResults[0].year})</span>
            </div>
          )}

          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-2 font-sans">
            Found {searchResults ? searchResults.length : 0} titles. Select any movie poster to explore its 35mm film stills.
          </p>
        </div>

        <a 
          href="/" 
          class="glass-btn px-4 py-2 rounded-xl text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white self-start sm:self-center shrink-0"
        >
          Clear Search
        </a>
      </div>

      <!-- Poster Grid -->
      {searchResults && searchResults.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5 sm:gap-6 lg:gap-8">
          {searchResults.map((m, index) => (
            <MoviePosterCard movie={m} index={index} />
          ))}
        </div>
      ) : (
        <div class="glass-card rounded-3xl p-12 sm:p-16 text-center border border-zinc-200/80 dark:border-zinc-800/80 max-w-xl mx-auto">
          <div class="w-12 h-12 rounded-2xl glass-btn flex items-center justify-center mx-auto mb-4 text-zinc-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <p class="text-xl font-bold text-zinc-800 dark:text-zinc-200">No movie posters found for "{searchQuery}"</p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2">
            Try searching another movie title like "Fight Club", "Blade Runner", or "Interstellar".
          </p>
          <a 
            href="/" 
            class="glass-btn-primary inline-block mt-6 px-5 py-2.5 rounded-xl text-xs font-semibold"
          >
            Return to Featured Films
          </a>
        </div>
      )}

    </section>
  ) : (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      
      <!-- Quick Film Catalog Selector Bar -->
      <div class="glass-panel-elevated p-1.5 rounded-2xl flex items-center gap-1.5 overflow-x-auto mb-8 border border-zinc-200/70 dark:border-zinc-800/70 scrollbar-none">
        <span class="text-[11px] uppercase tracking-wider font-mono text-zinc-400 dark:text-zinc-500 px-3 whitespace-nowrap">
          Featured:
        </span>
        {featuredMovies.map(item => (
          <a 
            href={`/?id=${item.id}`}
            class={`px-3 py-1.5 text-xs font-medium rounded-xl whitespace-nowrap transition-all ${
              item.id === currentId 
                ? 'glass-btn-primary shadow-xs' 
                : 'text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-white/60 dark:hover:bg-zinc-800/60'
            }`}
          >
            {item.title} <span class="opacity-60 text-[10px] font-mono">({item.year})</span>
          </a>
        ))}
      </div>

      <!-- Active Movie Hero Glass Card -->
      <div class="glass-card rounded-3xl p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6 border border-white/80 dark:border-white/10">
        <div class="flex items-start gap-5">
          {movie.posterUrl && (
            <img 
              src={movie.posterUrl} 
              alt={movie.title} 
              class="w-20 sm:w-24 aspect-[2/3] object-cover rounded-2xl border border-black/5 dark:border-white/10 shadow-md hidden sm:block shrink-0" 
            />
          )}
          <div>
            <div class="flex items-center gap-2 mb-2 flex-wrap">
              <span class="glass-pill text-[10px] font-mono px-2 py-0.5 rounded-full text-zinc-600 dark:text-zinc-400 font-medium">
                INDEX #{movie.tmdbId}
              </span>
              <span class="text-zinc-300 dark:text-zinc-700">•</span>
              <span class="text-xs font-mono text-emerald-600 dark:text-emerald-400 font-medium flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                API ACTIVE
              </span>
            </div>

            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              {movie.title} <span class="text-xl sm:text-2xl font-normal text-zinc-400 dark:text-zinc-500 font-sans">({movie.year})</span>
            </h1>

            <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-2 max-w-2xl font-sans">
              {movie.director ? `Directed by ${movie.director} • ` : ''}{movie.aspectRatio || '35mm Anamorphic'} • {frames.length} Stills Archived
            </p>

            {movie.overview && (
              <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2 max-w-2xl line-clamp-2">
                {movie.overview}
              </p>
            )}
          </div>
        </div>

        <!-- Quick Action Buttons -->
        <div class="flex items-center gap-2.5 flex-wrap self-start md:self-center shrink-0">
          <a 
            href={`/api/frames?movie_id=${movie.tmdbId}`} 
            target="_blank"
            class="glass-btn px-4 py-2 rounded-xl text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>REST API</span>
          </a>
          
          <button 
            onclick={`openUploadWithMovie('${movie.tmdbId}')`}
            class="glass-btn-primary px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            <span>Pin Frame</span>
          </button>
        </div>
      </div>
    </section>

    <!-- ================= CINEMA FRAMES GRID ================= -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
      {frames.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
          {frames.map((frame, index) => (
            <PolaroidCard frame={frame} movieTitle={movie.title} index={index} />
          ))}

          <!-- Pin Frame Call-to-Action Card -->
          <div 
            onclick={`openUploadWithMovie('${movie.tmdbId}')`}
            class="glass-card glass-card-hover rounded-2xl p-8 flex flex-col items-center justify-center text-center cursor-pointer min-h-[220px] border-2 border-dashed border-zinc-300 dark:border-zinc-700/80 hover:border-zinc-500 dark:hover:border-zinc-400 group"
          >
            <div class="w-12 h-12 rounded-2xl glass-btn flex items-center justify-center mb-3 group-hover:scale-105 transition-transform text-zinc-600 dark:text-zinc-300">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
            </div>
            <p class="text-base font-semibold text-zinc-900 dark:text-zinc-100">Pin New Frame</p>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
              Direct upload to Catbox • Saved to KV
            </p>
          </div>
        </div>
      ) : (
        <div class="glass-card rounded-3xl p-12 text-center border border-zinc-200/80 dark:border-zinc-800/80 max-w-lg mx-auto">
          <p class="text-lg font-bold text-zinc-800 dark:text-zinc-200">No frames collected yet for this title.</p>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2">
            Be the first archivist to pin a 35mm frame. Your upload streams directly to Catbox with a public API endpoint.
          </p>
          <button 
            onclick={`openUploadWithMovie('${movie.tmdbId}')`}
            class="glass-btn-primary mt-6 px-5 py-2.5 rounded-xl text-xs font-semibold"
          >
            + Pin The First Frame
          </button>
        </div>
      )}

      <!-- ================= DEVELOPER API TERMINAL SECTION ================= -->
      <section class="mt-16 sm:mt-20">
        <div class="glass-card rounded-3xl p-6 sm:p-8 border border-zinc-200/80 dark:border-zinc-800/80 shadow-xl">
          <div class="flex items-center justify-between gap-4 flex-wrap pb-5 border-b border-zinc-200/60 dark:border-zinc-800/60">
            <div>
              <span class="glass-pill text-[10px] font-mono px-2 py-0.5 rounded-full text-emerald-600 dark:text-emerald-400 font-semibold">
                OPEN REST API
              </span>
              <h3 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-1.5">
                Developer Documentation
              </h3>
            </div>
            <button 
              onclick={`copyToClipboard('${Astro.url.origin}/api/frames?movie_id=${movie.tmdbId}')`}
              class="glass-btn px-3.5 py-1.5 rounded-xl text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white flex items-center gap-1.5"
            >
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              <span>Copy Endpoint URL</span>
            </button>
          </div>

          <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6 text-xs font-mono">
            <div>
              <p class="text-zinc-500 dark:text-zinc-400 mb-2">// 1. Retrieve all frames for any movie:</p>
              <div class="bg-zinc-950 text-emerald-400 p-3.5 rounded-xl border border-zinc-800 select-all overflow-x-auto shadow-inner">
                curl -X GET "{Astro.url.origin}/api/frames?movie_id={movie.tmdbId}"
              </div>
              
              <p class="text-zinc-500 dark:text-zinc-400 mt-5 mb-2">// 2. Programmatic frame upload via Catbox:</p>
              <div class="bg-zinc-950 text-amber-300 p-3.5 rounded-xl border border-zinc-800 select-all overflow-x-auto shadow-inner">
                curl -X POST "{Astro.url.origin}/api/upload" \<br/>
                &nbsp;&nbsp;-F "tmdb_id={movie.tmdbId}" \<br/>
                &nbsp;&nbsp;-F "timestamp=01:24:15" \<br/>
                &nbsp;&nbsp;-F "frame=@still.jpg"
              </div>
            </div>

            <div>
              <p class="text-zinc-500 dark:text-zinc-400 mb-2">// Sample JSON Response (Zero Database):</p>
              <div class="bg-zinc-950 text-zinc-300 p-3.5 rounded-xl border border-zinc-800 overflow-x-auto max-h-52 text-[11px] shadow-inner">
<pre>{`{
  "status": "success",
  "movie": { "tmdbId": "${movie.tmdbId}", "title": "${movie.title}" },
  "totalFrames": ${frames.length},
  "frames": [
    {
      "timestamp": "${frames[0]?.timestamp || '01:42:15'}",
      "url": "${frames[0]?.url || 'https://files.catbox.moe/example.webp'}",
      "aspectRatio": "2.39:1"
    }
  ]
}`}</pre>
              </div>
            </div>
          </div>
        </div>
      </section>

    </main>
  )}

</Layout>
