---
import Layout from '../../layouts/Layout.astro';
import PolaroidCard from '../../components/PolaroidCard.astro';
import { getFramesForMovie } from '../../lib/storage';
import { getTmdbMovieDetails, getTmdbMovieBackdrops } from '../../lib/tmdb';
import { getAppEnv } from '../../lib/env';

export const prerender = false;

const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/');
}

const appEnv = getAppEnv();
const apiKey = appEnv?.TMDB_API_KEY || (typeof process !== 'undefined' ? process.env?.TMDB_API_KEY : undefined);

const [movie, userFrames] = await Promise.all([
  getTmdbMovieDetails(id, apiKey),
  getFramesForMovie(id)
]);

let frames = userFrames;
if (frames.length === 0) {
  frames = await getTmdbMovieBackdrops(id, apiKey);
}

const primaryHeroImage = frames[0]?.url || movie.backdropUrl || movie.posterUrl || '';
---

<Layout title={`${movie.title} (${movie.year}) — Film Stills Archive`}>
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8 pb-4">
    
    <div class="mb-4">
      <a href="/" class="font-mono text-xs font-bold uppercase hover:bg-[var(--accent-dynamic,#e2f952)] hover:text-[var(--accent-contrast,#000000)] px-2 py-1 border border-black dark:border-white inline-block transition-colors">
        ← BACK TO CATALOG
      </a>
    </div>

    <!-- Active Movie Record Brutalist Card -->
    <div class="brutal-card p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6 rounded-none">
      <div class="flex items-start gap-5">
        {movie.posterUrl && (
          <img 
            src={movie.posterUrl} 
            alt={movie.title} 
            crossorigin="anonymous"
            class="w-24 sm:w-28 aspect-[2/3] object-cover border-2 border-black dark:border-white shadow-[4px_4px_0px_#000000] dark:shadow-[4px_4px_0px_#ffffff] hidden sm:block shrink-0 rounded-none" 
          />
        )}
        <div>
          <div class="flex items-center gap-2 mb-2 flex-wrap">
            <span class="brutal-tag text-[10px] font-bold">
              TMDB RECORD #{movie.tmdbId}
            </span>
            <span class="font-mono font-bold text-zinc-500">//</span>
            <span class="brutal-tag-accent text-[10px] font-bold">
              REST API READY
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl font-black uppercase tracking-tight text-black dark:text-white">
            {movie.title} <span class="text-xl sm:text-2xl font-bold text-zinc-500 font-mono">[{movie.year}]</span>
          </h1>

          <p class="font-mono text-xs sm:text-sm font-bold uppercase text-zinc-700 dark:text-zinc-300 mt-2">
            {movie.director ? `DIR. ${movie.director} • ` : ''}{movie.aspectRatio || '35MM WIDESCREEN'} • {frames.length} ARCHIVED STILLS
          </p>

          {movie.overview && (
            <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-2 max-w-2xl line-clamp-2 font-mono uppercase font-bold">
              {movie.overview}
            </p>
          )}

          <!-- Interactive Cinema Frame Palette Bar -->
          <div id="heroPaletteSection" class="mt-4 pt-3 border-t-2 border-black/15 dark:border-white/15 flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2 font-mono">
              <span class="text-[10px] uppercase font-black tracking-wider text-black dark:text-white shrink-0">
                FRAME PALETTE:
              </span>
              <div id="heroPaletteStrip" class="flex items-center h-5 border-2 border-black dark:border-white shadow-[2px_2px_0px_#000] dark:shadow-[2px_2px_0px_#fff]">
                <!-- Swatches injected dynamically -->
              </div>
            </div>

            <span id="heroPaletteLabel" class="font-mono text-[10px] uppercase font-bold text-zinc-600 dark:text-zinc-400">
              EXTRACTING STILL PALETTE...
            </span>

            <button 
              id="resetPaletteBtn"
              onclick="window.resetDynamicPalette()"
              class="font-mono text-[10px] font-bold uppercase px-2 py-0.5 border border-black dark:border-white hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors hidden"
              title="Reset to frame default"
            >
              UNLOCK [↺]
            </button>
          </div>

        </div>
      </div>

      <!-- Brutalist Action Controls -->
      <div class="flex items-center gap-2.5 flex-wrap self-start md:self-center shrink-0 font-mono">
        <a 
          href={`/api/frames?movie_id=${movie.tmdbId}`} 
          target="_blank"
          class="brutal-btn px-4 py-2 text-xs uppercase font-bold rounded-none flex items-center gap-1.5"
        >
          <span>[ API ]</span>
        </a>
        
        <button 
          onclick={`openUploadWithMovie('${movie.tmdbId}')`}
          class="brutal-btn-primary px-4 py-2 text-xs uppercase font-black rounded-none flex items-center gap-1.5"
        >
          <span>+ PIN FRAME</span>
        </button>
      </div>
    </div>
  </section>

  <!-- ================= CINEMA STILLS GRID ================= -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {frames.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {frames.map((frame, index) => (
          <PolaroidCard frame={frame} movieTitle={movie.title} index={index} />
        ))}

        <!-- Pin Frame Call-to-Action Card -->
        <div 
          onclick={`openUploadWithMovie('${movie.tmdbId}')`}
          class="brutal-card brutal-card-hover p-6 flex flex-col items-center justify-center text-center cursor-pointer min-h-[220px] rounded-none border-2 border-dashed border-black dark:border-white group"
        >
          <div class="w-12 h-12 border-2 border-black dark:border-white bg-dynamic-accent font-black text-2xl flex items-center justify-center mb-3 group-hover:scale-105 transition-transform">
            +
          </div>
          <p class="font-black text-base uppercase tracking-tight text-black dark:text-white">PIN NEW FRAME</p>
          <p class="font-mono text-xs font-bold text-zinc-600 dark:text-zinc-400 mt-1 uppercase">
            STREAM DIRECTLY TO CATBOX • KV
          </p>
        </div>
      </div>
    ) : (
      <div class="brutal-card p-12 text-center max-w-lg mx-auto rounded-none">
        <p class="text-xl font-black uppercase text-black dark:text-white">NO STILLS COLLECTED YET</p>
        <p class="font-mono text-xs text-zinc-600 dark:text-zinc-400 mt-2 uppercase font-bold">
          BE THE FIRST CINEMATOGRAPHER TO PIN A 35MM FRAME.
        </p>
        <button 
          onclick={`openUploadWithMovie('${movie.tmdbId}')`}
          class="brutal-btn-primary mt-6 px-6 py-2.5 text-xs uppercase font-black rounded-none"
        >
          + PIN FIRST FRAME
        </button>
      </div>
    )}

    <!-- ================= DEVELOPER API DOCUMENTATION BLOCK ================= -->
    <section class="mt-16 sm:mt-20">
      <div class="brutal-card p-6 sm:p-8 rounded-none">
        <div class="flex items-center justify-between gap-4 flex-wrap pb-4 border-b-2 border-black dark:border-white">
          <div>
            <span class="brutal-tag-accent text-[10px] font-bold">
              [ OPEN REST API ]
            </span>
            <h3 class="text-2xl font-black uppercase tracking-tight text-black dark:text-white mt-1">
              DEVELOPER ACCESS
            </h3>
          </div>
          <button 
            onclick={`copyToClipboard('${Astro.url.origin}/api/frames?movie_id=${movie.tmdbId}')`}
            class="brutal-btn px-4 py-2 text-xs font-mono uppercase font-bold rounded-none flex items-center gap-1.5"
          >
            COPY ENDPOINT ⎘
          </button>
        </div>

        <div class="mt-6 grid grid-cols-1 lg:grid-cols-2 gap-6 text-xs font-mono font-bold">
          <div>
            <p class="text-zinc-600 dark:text-zinc-400 mb-2 uppercase">// 1. GET FRAMES FOR MOVIE:</p>
            <div class="bg-black text-dynamic-accent p-3.5 border-2 border-black dark:border-white shadow-[4px_4px_0px_#000000] dark:shadow-[4px_4px_0px_#ffffff] select-all overflow-x-auto rounded-none font-bold">
              curl -X GET "{Astro.url.origin}/api/frames?movie_id={movie.tmdbId}"
            </div>
            
            <p class="text-zinc-600 dark:text-zinc-400 mt-5 mb-2 uppercase">// 2. UPLOAD FRAME VIA MULTIPART:</p>
            <div class="bg-black text-white p-3.5 border-2 border-black dark:border-white shadow-[4px_4px_0px_#000000] dark:shadow-[4px_4px_0px_#ffffff] select-all overflow-x-auto rounded-none">
              curl -X POST "{Astro.url.origin}/api/upload" \<br/>
              &nbsp;&nbsp;-F "tmdb_id={movie.tmdbId}" \<br/>
              &nbsp;&nbsp;-F "timestamp=01:24:15" \<br/>
              &nbsp;&nbsp;-F "frame=@still.jpg"
            </div>
          </div>

          <div>
            <p class="text-zinc-600 dark:text-zinc-400 mb-2 uppercase">// JSON PAYLOAD SCHEMA (ZERO DB):</p>
            <div class="bg-black text-white p-3.5 border-2 border-black dark:border-white shadow-[4px_4px_0px_#000000] dark:shadow-[4px_4px_0px_#ffffff] overflow-x-auto max-h-52 text-[11px] rounded-none">
<pre>{`{
  "status": "success",
  "movie": { "tmdbId": "${movie.tmdbId}", "title": "${movie.title}" },
  "totalFrames": ${frames.length},
  "frames": [
    {
      "timestamp": "${frames[0]?.timestamp || '01:42:15'}",
      "url": "${frames[0]?.url || 'https://files.catbox.moe/example.webp'}",
      "aspectRatio": "2.39:1"
    }
  ]
}`}</pre>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ initialHeroUrl: primaryHeroImage, initialMovieTitle: `${movie.title} (${movie.year})` }}>
    if (initialHeroUrl) {
      if (window.initHeroFramePalette) {
        window.initHeroFramePalette(initialHeroUrl, initialMovieTitle);
      } else {
        window.addEventListener('DOMContentLoaded', () => {
          if (window.initHeroFramePalette) {
            window.initHeroFramePalette(initialHeroUrl, initialMovieTitle);
          }
        });
      }
    }
  </script>
</Layout>
