---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Archive.Frame — 35mm Cinema Index',
  description = 'A modern zero-database cinematography repository of movie stills and cinema frames, powered by Catbox CDN and Cloudflare KV.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts: Plus Jakarta Sans & Space Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
</head>

<body class="neoblur-canvas min-h-screen text-zinc-900 dark:text-zinc-100 transition-colors duration-300 font-sans selection:bg-zinc-900 selection:text-white dark:selection:bg-white dark:selection:text-zinc-950 antialiased">

  <!-- ================= TOP ARCHIVE HEADER ================= -->
  <header class="border-b border-zinc-200/60 dark:border-zinc-800/60 glass-panel-elevated sticky top-0 z-40 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col md:flex-row items-center justify-between gap-3 sm:gap-4">
      
      <!-- Brand & Version Pill -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none">
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              Archive<span class="text-zinc-400 dark:text-zinc-500 font-normal">.Frame</span>
            </span>
            <span class="glass-pill text-[10px] font-mono px-2 py-0.5 rounded-full text-zinc-600 dark:text-zinc-400 font-medium">
              v1.0
            </span>
          </div>
          <p class="font-mono text-[10px] text-zinc-400 dark:text-zinc-500 tracking-wider">
            CINEMATOGRAPHY REPOSITORY • ZERO-DB API
          </p>
        </div>
      </a>

      <!-- Search & Header Controls -->
      <div class="flex items-center gap-2.5 w-full md:w-auto relative">
        
        <!-- Live TMDB Search Input with Glass Form & Dropdown -->
        <form action="/" method="GET" class="relative flex-1 md:w-80 flex items-center">
          <input 
            type="text" 
            name="q"
            id="globalSearchInput"
            placeholder="Search movies (e.g. Fight Club)..." 
            autocomplete="off"
            class="glass-input w-full pl-9 pr-8 py-2 text-xs sm:text-sm rounded-xl text-zinc-800 dark:text-zinc-200 placeholder-zinc-400 dark:placeholder-zinc-500 font-sans focus:outline-none"
          />
          <button type="submit" class="absolute left-2.5 top-2.5 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors" title="Search">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </button>
          
          <!-- Floating Glass Autocomplete Dropdown -->
          <div id="searchDropdown" class="glass-panel-elevated absolute left-0 right-0 top-full mt-2 rounded-2xl shadow-2xl max-h-96 overflow-y-auto hidden z-50 p-1.5 border border-zinc-200/80 dark:border-zinc-800/80">
          </div>
        </form>

        <!-- Pin Frame Action Trigger -->
        <button 
          id="openUploadBtn"
          class="glass-btn-primary flex items-center gap-1.5 px-3.5 py-2 rounded-xl font-medium text-xs tracking-wide shadow-xs active:scale-95 whitespace-nowrap"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          <span>Pin Frame</span>
        </button>

        <!-- Dark / Light Mode Toggle -->
        <button 
          id="themeToggleBtn"
          title="Toggle Dark / Light Mode"
          class="glass-btn p-2 rounded-xl text-zinc-600 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white transition-colors"
        >
          <span id="themeIcon">🌙</span>
        </button>
      </div>

    </div>
  </header>

  <!-- ================= MAIN CONTENT INJECTION ================= -->
  <slot />

  <!-- ================= MINIMAL GLASS FOOTER ================= -->
  <footer class="border-t border-zinc-200/60 dark:border-zinc-800/60 mt-20 py-8 text-center font-mono text-xs text-zinc-400 dark:text-zinc-500">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p>ARCHIVE.FRAME • POWERED BY CATBOX CDN & CLOUDFLARE KV • ZERO-DATABASE ENGINE</p>
      <div class="flex items-center gap-4">
        <a href="/api/frames?movie_id=157336" target="_blank" class="hover:underline text-zinc-600 dark:text-zinc-300 transition-colors">Open Sample API</a>
        <span>•</span>
        <p>DATA FROM THE MOVIE DATABASE (TMDB)</p>
      </div>
    </div>
  </footer>

  <!-- ================= FLOATING GLASS UPLOAD MODAL ================= -->
  <div id="uploadModal" class="fixed inset-0 bg-black/40 dark:bg-black/60 backdrop-blur-md flex items-center justify-center z-50 hidden p-4">
    <div class="glass-panel-elevated max-w-lg w-full p-6 sm:p-8 rounded-3xl relative shadow-2xl border border-white/60 dark:border-white/10 animate-in fade-in zoom-in-95 duration-200">
      <button id="closeUploadModalBtn" class="glass-btn absolute top-5 right-5 w-8 h-8 rounded-full flex items-center justify-center text-zinc-400 hover:text-zinc-900 dark:hover:text-white text-xs">
        ✕
      </button>

      <div class="border-b border-zinc-200/60 dark:border-zinc-800/60 pb-4 mb-6">
        <span class="glass-pill text-[10px] font-mono px-2 py-0.5 rounded-full text-zinc-600 dark:text-zinc-400 font-medium">
          CATBOX CDN INGEST
        </span>
        <h3 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-2">
          Pin Frame to Archive
        </h3>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-1">
          Zero hosting cost • Permanent Catbox direct file storage
        </p>
      </div>

      <form id="uploadForm" class="space-y-4 text-xs font-sans">
        <div>
          <label class="block font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">TMDB Movie ID / Title</label>
          <input 
            type="text" 
            name="tmdb_id" 
            id="modalTmdbId" 
            placeholder="e.g. 157336" 
            required 
            class="glass-input w-full p-2.5 rounded-xl font-mono text-zinc-900 dark:text-zinc-100 focus:outline-none" 
          />
        </div>

        <div>
          <label class="block font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Timestamp (HH:MM:SS)</label>
          <input 
            type="text" 
            name="timestamp" 
            placeholder="e.g. 01:24:15" 
            required 
            class="glass-input w-full p-2.5 rounded-xl font-mono text-zinc-900 dark:text-zinc-100 focus:outline-none" 
          />
        </div>

        <div>
          <label class="block font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Scene Note / Description</label>
          <input 
            type="text" 
            name="tag" 
            placeholder="e.g. Accretion Disk Orbit" 
            class="glass-input w-full p-2.5 rounded-xl text-zinc-900 dark:text-zinc-100 focus:outline-none" 
          />
        </div>

        <div>
          <label class="block font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Aspect Ratio</label>
          <select name="aspect_ratio" class="glass-input w-full p-2.5 rounded-xl font-mono text-zinc-900 dark:text-zinc-100 focus:outline-none">
            <option value="2.39:1">2.39:1 (Anamorphic Scope)</option>
            <option value="70mm IMAX">70mm IMAX (1.43:1 / 1.90:1)</option>
            <option value="1.85:1">1.85:1 (Flat Widescreen)</option>
            <option value="1.37:1">1.37:1 (Academy Ratio)</option>
          </select>
        </div>

        <div>
          <label class="block font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Select Image (Movie Still)</label>
          <div class="rounded-2xl border-2 border-dashed border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/30 p-5 text-center hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <input 
              type="file" 
              name="frame" 
              accept="image/*" 
              required 
              class="text-zinc-500 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-medium file:bg-zinc-900 file:text-white dark:file:bg-white dark:file:text-zinc-900 cursor-pointer" 
            />
            <p class="text-[10px] text-zinc-400 mt-2">Directly uploaded to Catbox.moe • Zero host storage used</p>
          </div>
        </div>

        <div class="pt-2 flex justify-end gap-2.5">
          <button type="button" id="cancelUploadBtn" class="glass-btn px-4 py-2 rounded-xl text-zinc-600 dark:text-zinc-300 font-medium">
            Cancel
          </button>
          <button type="submit" id="submitUploadBtn" class="glass-btn-primary px-5 py-2 rounded-xl font-semibold tracking-wide flex items-center gap-2">
            <span id="uploadBtnText">Upload & Save</span>
            <span id="uploadSpinner" class="hidden animate-spin">⏳</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= FLOATING GLASS LIGHTBOX MODAL ================= -->
  <div id="lightboxModal" class="fixed inset-0 bg-black/85 backdrop-blur-xl flex items-center justify-center z-50 hidden p-4 sm:p-8">
    <div class="max-w-5xl w-full flex flex-col items-center" id="lightboxContent">
      <div class="glass-panel-elevated w-full rounded-2xl shadow-2xl p-3 sm:p-4 border border-white/15 dark:border-white/10">
        
        <!-- Cinema Screen Box -->
        <div class="aspect-[2.39/1] overflow-hidden rounded-xl bg-black flex items-center justify-center relative">
          <img id="lightboxImg" src="" alt="Cinema Frame" class="max-w-full max-h-[70vh] object-contain rounded-lg" />
        </div>

        <!-- Lightbox Footer Controls -->
        <div class="pt-3.5 pb-1 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-zinc-900 dark:text-zinc-100">
          <div>
            <h4 id="lightboxTitle" class="text-lg sm:text-xl font-bold tracking-tight">Movie Title</h4>
            <p id="lightboxTime" class="font-mono text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">⏱ 00:00:00</p>
          </div>
          <div class="flex items-center gap-2.5">
            <button id="lightboxCopyBtn" class="glass-btn px-4 py-2 rounded-xl font-mono text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-white flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span>Copy Catbox URL</span>
            </button>
            <button id="closeLightboxBtn" class="glass-btn-primary px-4 py-2 rounded-xl text-xs font-semibold">
              Close [ESC]
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ================= GLASS PILL TOAST NOTIFICATION ================= -->
  <div id="toast" class="glass-panel-elevated rounded-full px-5 py-2.5 text-xs font-medium text-zinc-900 dark:text-zinc-100 shadow-2xl fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-300 flex items-center gap-2 border border-white/60 dark:border-white/15">
    <span class="text-emerald-500 font-bold">✓</span>
    <span id="toastMsg">Notification message</span>
  </div>

  <!-- ================= CLIENT SCRIPTS ================= -->
  <script is:inline>
    // Theme setup
    const themeBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');
    
    // Check saved theme or system preference
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
      themeIcon.textContent = '☀️';
    } else {
      document.documentElement.classList.remove('dark');
      themeIcon.textContent = '🌙';
    }

    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      themeIcon.textContent = isDark ? '☀️' : '🌙';
    });

    // Toast helper
    window.showToast = function(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2800);
    };

    window.copyToClipboard = function(text) {
      navigator.clipboard.writeText(text).then(() => {
        window.showToast('Copied to clipboard: ' + text);
      });
    };

    // Upload modal logic
    const uploadModal = document.getElementById('uploadModal');
    const openUploadBtn = document.getElementById('openUploadBtn');
    const closeUploadModalBtn = document.getElementById('closeUploadModalBtn');
    const cancelUploadBtn = document.getElementById('cancelUploadBtn');
    const uploadForm = document.getElementById('uploadForm');

    window.openUploadWithMovie = function(tmdbId) {
      const idInput = document.getElementById('modalTmdbId');
      if (idInput && tmdbId) idInput.value = tmdbId;
      uploadModal?.classList.remove('hidden');
    };

    openUploadBtn?.addEventListener('click', () => {
      uploadModal?.classList.remove('hidden');
    });

    function hideUploadModal() {
      uploadModal?.classList.add('hidden');
    }
    closeUploadModalBtn?.addEventListener('click', hideUploadModal);
    cancelUploadBtn?.addEventListener('click', hideUploadModal);

    uploadForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submitUploadBtn');
      const btnText = document.getElementById('uploadBtnText');
      const spinner = document.getElementById('uploadSpinner');

      const formData = new FormData(uploadForm);
      btnText.textContent = 'Ingesting to Catbox...';
      spinner.classList.remove('hidden');
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        
        if (res.ok && data.status === 'success') {
          window.showToast('Frame pinned! Permanent Catbox URL created.');
          hideUploadModal();
          uploadForm.reset();
          // Reload to show the newly pinned frame
          setTimeout(() => window.location.reload(), 1200);
        } else {
          alert('Upload failed: ' + (data.message || 'Unknown error'));
        }
      } catch (err) {
        alert('Upload failed: ' + err.message);
      } finally {
        btnText.textContent = 'Upload & Save';
        spinner.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });

    // Lightbox modal logic
    const lightboxModal = document.getElementById('lightboxModal');
    const closeLightboxBtn = document.getElementById('closeLightboxBtn');
    const lightboxContent = document.getElementById('lightboxContent');
    let currentLightboxUrl = '';

    window.showLightbox = function(url, title, time) {
      currentLightboxUrl = url;
      document.getElementById('lightboxImg').src = url;
      document.getElementById('lightboxTitle').textContent = title;
      document.getElementById('lightboxTime').textContent = `⏱ Timestamp: ${time}`;
      lightboxModal?.classList.remove('hidden');
    };

    function hideLightbox() {
      lightboxModal?.classList.add('hidden');
    }
    closeLightboxBtn?.addEventListener('click', hideLightbox);
    lightboxModal?.addEventListener('click', (e) => {
      if (e.target === lightboxModal) hideLightbox();
    });

    document.getElementById('lightboxCopyBtn')?.addEventListener('click', () => {
      if (currentLightboxUrl) {
        window.copyToClipboard(currentLightboxUrl);
      }
    });

    // Global keyboard shortcuts
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideLightbox();
        hideUploadModal();
        document.getElementById('searchDropdown')?.classList.add('hidden');
      }
    });

    // Live TMDB Search Autocomplete
    const searchInput = document.getElementById('globalSearchInput');
    const searchDropdown = document.getElementById('searchDropdown');
    let searchDebounce = null;

    searchInput?.addEventListener('input', (e) => {
      clearTimeout(searchDebounce);
      const query = e.target.value.trim();

      if (query.length < 2) {
        searchDropdown.classList.add('hidden');
        searchDropdown.innerHTML = '';
        return;
      }

      searchDebounce = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
          const data = await res.json();

          if (data.results && data.results.length > 0) {
            let typoHeader = '';
            if (data.topMatch && data.topMatch.toLowerCase() !== query.toLowerCase()) {
              typoHeader = `
                <div class="px-3 py-2 bg-blue-50/80 dark:bg-blue-950/40 rounded-xl mb-1 flex items-center gap-1.5 font-mono text-[11px] text-blue-800 dark:text-blue-300 border border-blue-200/60 dark:border-blue-800/40">
                  <span class="text-blue-500">✦</span>
                  <span>Typo auto-match: <strong>${data.topMatch}</strong></span>
                </div>
              `;
            }

            const listHtml = data.results.map(m => `
              <a href="/movie/${m.tmdbId}" class="flex items-center gap-3 p-2 rounded-xl hover:bg-zinc-100/80 dark:hover:bg-zinc-800/60 transition-colors group">
                <img 
                  src="${m.posterUrl || 'https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=150&q=80'}" 
                  class="w-10 h-14 object-cover rounded-lg border border-black/5 dark:border-white/10 shadow-xs shrink-0" 
                />
                <div class="flex-1 min-w-0">
                  <div class="font-medium text-xs sm:text-sm text-zinc-900 dark:text-zinc-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors truncate">
                    ${m.title} <span class="font-mono text-[11px] text-zinc-400">(${m.year})</span>
                  </div>
                  <div class="text-[11px] text-zinc-500 dark:text-zinc-400 truncate mt-0.5">
                    ${m.overview ? m.overview.substring(0, 50) + '...' : 'TMDB #' + m.tmdbId}
                  </div>
                  <span class="inline-block text-[10px] text-zinc-500 group-hover:text-zinc-900 dark:group-hover:text-zinc-200 mt-1 uppercase tracking-wider font-mono">
                    View frames →
                  </span>
                </div>
              </a>
            `).join('');

            const viewAllFooter = `
              <a href="/?q=${encodeURIComponent(query)}" class="block mt-1.5 p-2 text-center font-mono text-xs rounded-xl bg-zinc-100/70 dark:bg-zinc-800/60 hover:bg-zinc-200/70 dark:hover:bg-zinc-700/60 text-zinc-700 dark:text-zinc-300 font-medium transition-colors">
                View all poster results on full page →
              </a>
            `;

            searchDropdown.innerHTML = typoHeader + listHtml + viewAllFooter;
            searchDropdown.classList.remove('hidden');
          } else {
            searchDropdown.innerHTML = `<div class="p-4 text-xs font-mono text-zinc-400 text-center">No movies found for "${query}".</div>`;
            searchDropdown.classList.remove('hidden');
          }
        } catch (err) {
          console.error(err);
        }
      }, 250);
    });

    document.addEventListener('click', (e) => {
      if (!searchInput?.contains(e.target) && !searchDropdown?.contains(e.target)) {
        searchDropdown?.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
