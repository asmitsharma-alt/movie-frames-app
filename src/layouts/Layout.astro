---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Archive.Frame — 35mm Cinema Archive & Public REST API',
  description = 'A zero-database brutalist cinema frame repository and public API powered by Catbox CDN and Cloudflare KV.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Google Fonts: Space Grotesk (Editorial Brutalist) & Space Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
</head>

<body class="min-h-screen transition-colors duration-150 font-sans selection:bg-[var(--accent-dynamic,#e2f952)] selection:text-[var(--accent-contrast,#000000)]">

  <!-- ================= NEO-BRUTALIST TOP NAVIGATION ================= -->
  <header class="border-b-2 border-black dark:border-white bg-[#f5f4ef] dark:bg-[#0d0d0f] sticky top-0 z-40 transition-colors">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col md:flex-row items-center justify-between gap-3 sm:gap-4">
      
      <!-- Brand & Technical Tag -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none">
        <div class="flex flex-col">
          <div class="flex items-center gap-2">
            <span class="text-2xl sm:text-3xl font-black uppercase tracking-tighter text-black dark:text-white group-hover:bg-[var(--accent-dynamic,#e2f952)] group-hover:text-[var(--accent-contrast,#000000)] transition-colors px-1 -ml-1">
              ARCHIVE.FRAME
            </span>
            <span class="brutal-tag text-[10px] font-mono px-2 py-0.5 font-bold">
              VOL.01
            </span>
          </div>
          <p class="font-mono text-[10px] text-zinc-600 dark:text-zinc-400 tracking-wider uppercase font-bold">
            ZERO-DATABASE 35MM REPOSITORY • DYNAMIC PALETTES
          </p>
        </div>
      </a>

      <!-- Search & Brutalist Controls -->
      <div class="flex items-center gap-2.5 w-full md:w-auto relative">
        
        <!-- Live Autocomplete Search Form -->
        <form action="/" method="GET" class="relative flex-1 md:w-80 flex items-center">
          <input 
            type="text" 
            name="q"
            id="globalSearchInput"
            placeholder="SEARCH MOVIES (E.G. FIGHT CLUB)..." 
            autocomplete="off"
            class="brutal-input w-full pl-9 pr-8 py-2 text-xs sm:text-sm uppercase font-mono font-bold tracking-tight rounded-none focus:outline-none placeholder:text-zinc-400 dark:placeholder:text-zinc-500"
          />
          <button type="submit" class="absolute left-2.5 top-2.5 text-black dark:text-white" title="Search">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </button>
          
          <!-- Brutalist Autocomplete Dropdown (Poster, Title, Year ONLY) -->
          <div id="searchDropdown" class="absolute left-0 right-0 top-full mt-2 bg-white dark:bg-[#141418] border-2 border-black dark:border-white shadow-[5px_5px_0px_#000000] dark:shadow-[5px_5px_0px_#ffffff] max-h-96 overflow-y-auto hidden z-50 p-2 divide-y-2 divide-black/10 dark:divide-white/10">
          </div>
        </form>

        <!-- Pin Frame Trigger -->
        <button 
          id="openUploadBtn"
          class="brutal-btn-primary px-3.5 py-2 text-xs uppercase font-bold tracking-wider rounded-none flex items-center gap-1.5 whitespace-nowrap"
        >
          <span class="text-sm leading-none font-black">+</span>
          <span>PIN FRAME</span>
        </button>

        <!-- Theme Toggle -->
        <button 
          id="themeToggleBtn"
          title="Toggle Dark / Light Mode"
          class="brutal-btn p-2 text-xs font-mono font-bold rounded-none flex items-center justify-center min-w-[36px]"
        >
          <span id="themeIcon">🌙</span>
        </button>
      </div>

    </div>
  </header>

  <!-- ================= MAIN CONTENT INJECTION ================= -->
  <slot />

  <!-- ================= NEO-BRUTALIST FOOTER ================= -->
  <footer class="border-t-2 border-black dark:border-white bg-white dark:bg-[#141418] mt-24 py-8 font-mono text-xs font-bold text-black dark:text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="uppercase tracking-wider">
        ARCHIVE.FRAME // ZERO-DATABASE SYSTEM // DYNAMIC CINEMA COLOR EXTRACTION
      </p>
      <div class="flex items-center gap-4 uppercase tracking-wider">
        <a href="/api/frames?movie_id=157336" target="_blank" class="hover:bg-[var(--accent-dynamic,#e2f952)] hover:text-[var(--accent-contrast,#000000)] px-1.5 py-0.5 border border-black dark:border-white transition-colors">
          OPEN API
        </a>
        <span>•</span>
        <p>TMDB INDEXED</p>
      </div>
    </div>
  </footer>

  <!-- ================= NEO-BRUTALIST PIN FRAME MODAL ================= -->
  <div id="uploadModal" class="fixed inset-0 bg-black/75 backdrop-blur-xs flex items-center justify-center z-50 hidden p-4">
    <div class="bg-white dark:bg-[#141418] border-2 sm:border-[3px] border-black dark:border-white shadow-[8px_8px_0px_#000000] dark:shadow-[8px_8px_0px_#ffffff] max-w-lg w-full p-6 sm:p-8 relative rounded-none">
      
      <button id="closeUploadModalBtn" class="brutal-btn absolute top-4 right-4 w-8 h-8 flex items-center justify-center font-mono font-black text-sm rounded-none">
        ✕
      </button>

      <div class="border-b-2 border-black dark:border-white pb-4 mb-6">
        <span class="brutal-tag-accent text-[10px] font-mono px-2 py-0.5 font-bold mb-2">
          [ CATBOX STREAM INGEST ]
        </span>
        <h3 class="text-2xl sm:text-3xl font-black uppercase tracking-tight text-black dark:text-white mt-1">
          PIN FRAME TO ARCHIVE
        </h3>
        <p class="text-xs font-mono text-zinc-600 dark:text-zinc-400 mt-1 uppercase">
          PERMANENT CATBOX CDN INGEST • 0 HOST STORAGE
        </p>
      </div>

      <form id="uploadForm" class="space-y-4 font-mono text-xs">
        <div>
          <label class="block font-bold uppercase tracking-wider text-black dark:text-white mb-1">TMDB MOVIE ID / TITLE</label>
          <input 
            type="text" 
            name="tmdb_id" 
            id="modalTmdbId" 
            placeholder="E.G. 157336" 
            required 
            class="brutal-input w-full p-2.5 font-bold text-xs uppercase rounded-none focus:outline-none" 
          />
        </div>

        <div>
          <label class="block font-bold uppercase tracking-wider text-black dark:text-white mb-1">TIMESTAMP (HH:MM:SS)</label>
          <input 
            type="text" 
            name="timestamp" 
            placeholder="01:24:15" 
            required 
            class="brutal-input w-full p-2.5 font-bold text-xs rounded-none focus:outline-none" 
          />
        </div>

        <div>
          <label class="block font-bold uppercase tracking-wider text-black dark:text-white mb-1">SCENE NOTE (OPTIONAL)</label>
          <input 
            type="text" 
            name="tag" 
            placeholder="ACCRETION DISK ORBIT" 
            class="brutal-input w-full p-2.5 font-bold text-xs uppercase rounded-none focus:outline-none" 
          />
        </div>

        <div>
          <label class="block font-bold uppercase tracking-wider text-black dark:text-white mb-1">ASPECT RATIO (OPTIONAL)</label>
          <select name="aspect_ratio" class="brutal-input w-full p-2.5 font-bold text-xs rounded-none focus:outline-none">
            <option value="2.39:1">2.39:1 (ANAMORPHIC SCOPE)</option>
            <option value="70mm IMAX">70MM IMAX (1.43:1 / 1.90:1)</option>
            <option value="1.85:1">1.85:1 (FLAT WIDESCREEN)</option>
            <option value="1.37:1">1.37:1 (ACADEMY RATIO)</option>
          </select>
        </div>

        <div>
          <label class="block font-bold uppercase tracking-wider text-black dark:text-white mb-1">SELECT MOVIE STILL</label>
          <div class="border-2 border-dashed border-black dark:border-white bg-[#f5f4ef] dark:bg-[#1a1a20] p-4 text-center rounded-none">
            <input 
              type="file" 
              name="frame" 
              accept="image/*" 
              required 
              class="text-zinc-600 dark:text-zinc-300 font-mono text-xs file:mr-4 file:py-1.5 file:px-3 file:border-2 file:border-black file:dark:border-white file:bg-black file:text-white file:dark:bg-white file:dark:text-black file:font-mono file:font-bold file:uppercase file:rounded-none cursor-pointer" 
            />
            <p class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-2 uppercase font-mono">
              DIRECT MULTIPART INGEST TO CATBOX.MOE
            </p>
          </div>
        </div>

        <div class="pt-2 flex justify-end gap-2.5">
          <button type="button" id="cancelUploadBtn" class="brutal-btn px-4 py-2 text-xs uppercase font-bold rounded-none">
            CANCEL
          </button>
          <button type="submit" id="submitUploadBtn" class="brutal-btn-primary px-6 py-2 text-xs uppercase font-black rounded-none flex items-center gap-2">
            <span id="uploadBtnText">UPLOAD & PIN</span>
            <span id="uploadSpinner" class="hidden animate-spin">⏳</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= NEO-BRUTALIST CINEMA LIGHTBOX ================= -->
  <div id="lightboxModal" class="fixed inset-0 bg-black/95 flex items-center justify-center z-50 hidden p-3 sm:p-6">
    <div class="max-w-5xl w-full flex flex-col items-center" id="lightboxContent">
      <div class="bg-black border-2 border-white shadow-[8px_8px_0px_#ffffff] w-full p-3 sm:p-5 rounded-none">
        
        <!-- Screen Box -->
        <div class="aspect-[2.39/1] overflow-hidden bg-black flex items-center justify-center border border-zinc-800 relative">
          <img id="lightboxImg" src="" alt="Cinema Still" crossorigin="anonymous" class="max-w-full max-h-[70vh] object-contain" />
        </div>

        <!-- Brutalist Metadata & Controls -->
        <div class="pt-3 pb-2 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-white font-mono">
          <div>
            <h4 id="lightboxTitle" class="text-base sm:text-lg font-black uppercase tracking-tight">MOVIE TITLE</h4>
            <p id="lightboxTime" class="text-xs font-bold mt-0.5 text-dynamic-accent">⏱ 00:00:00</p>
          </div>
          <div class="flex items-center gap-2.5 flex-wrap">
            <button id="lightboxLockBtn" class="brutal-btn px-3 py-1.5 text-xs uppercase font-bold rounded-none flex items-center gap-1.5" title="Lock this frame palette as UI theme">
              <span>LOCK THEME ⚡</span>
            </button>
            <button id="lightboxCopyBtn" class="brutal-btn px-3 py-1.5 text-xs uppercase font-bold rounded-none flex items-center gap-1.5">
              <span>COPY URL ⎘</span>
            </button>
            <button id="closeLightboxBtn" class="brutal-btn-primary px-3.5 py-1.5 text-xs uppercase font-black rounded-none">
              CLOSE [ESC]
            </button>
          </div>
        </div>

        <!-- Dynamic Frame Palette Bar inside Lightbox -->
        <div class="mt-2 pt-2 border-t border-zinc-800 flex flex-col sm:flex-row sm:items-center justify-between gap-2 font-mono text-xs">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-[10px] uppercase font-bold tracking-wider text-zinc-400 shrink-0">
              FRAME PALETTE:
            </span>
            <div id="lightboxPaletteStrip" class="flex items-center h-5 border border-white">
              <!-- Swatches injected dynamically -->
            </div>
            <span id="lightboxPaletteHexes" class="text-[10px] text-zinc-400 font-mono"></span>
          </div>
          <span class="text-[9px] uppercase tracking-wider text-zinc-500">
            CLICK ANY SWATCH TO COPY HEX CODE
          </span>
        </div>

      </div>
    </div>
  </div>

  <!-- ================= BRUTALIST PILL TOAST ================= -->
  <div id="toast" class="brutal-card-accent px-4 py-2 text-xs font-mono font-black fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 transition-all duration-150 flex items-center gap-2 border-2 border-black shadow-[4px_4px_0px_#000]">
    <span>✓</span>
    <span id="toastMsg" class="uppercase">NOTIFICATION MESSAGE</span>
  </div>

  <!-- ================= CLIENT SCRIPTS & CINEMA COLOR ENGINE ================= -->
  <script is:inline>
    // Theme setup
    const themeBtn = document.getElementById('themeToggleBtn');
    const themeIcon = document.getElementById('themeIcon');
    
    if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
      themeIcon.textContent = '☀️';
    } else {
      document.documentElement.classList.remove('dark');
      themeIcon.textContent = '🌙';
    }

    themeBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      themeIcon.textContent = isDark ? '☀️' : '🌙';
    });

    // Toast helper
    window.showToast = function(msg) {
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      if (!toast || !toastMsg) return;
      toastMsg.textContent = msg;
      toast.classList.remove('translate-y-20', 'opacity-0');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0');
      }, 2500);
    };

    window.copyToClipboard = function(text) {
      navigator.clipboard.writeText(text).then(() => {
        window.showToast(`COPIED: ${text}`);
      });
    };

    // =========================================================================
    // DYNAMIC CINEMA COLOR PALETTE ENGINE
    // Extracts dominant cinematic hues from 35mm frames and morphs UI theme
    // =========================================================================

    window._paletteCache = new Map();
    window._paletteLocked = false;
    window._currentPalette = ['#e2f952', '#141418', '#ffffff', '#52525b', '#d4d4d8'];
    window._defaultHeroPalette = null;
    window._defaultHeroLabel = '';

    function hexToRgb(hex) {
      if (!hex) return null;
      let clean = hex.replace('#', '');
      if (clean.length === 3) {
        clean = clean.split('').map(c => c + c).join('');
      }
      const num = parseInt(clean, 16);
      return {
        r: (num >> 16) & 255,
        g: (num >> 8) & 255,
        b: num & 255
      };
    }

    function rgbToHex(r, g, b) {
      const h = ((1 << 24) + (Math.round(r) << 16) + (Math.round(g) << 8) + Math.round(b)).toString(16).slice(1);
      return '#' + h;
    }

    // High-speed pixel sampler & color clustering
    window.extractPaletteFromImage = function(imgOrUrl, callback) {
      let src = typeof imgOrUrl === 'string' ? imgOrUrl : imgOrUrl.src;
      if (!src) return;

      if (window._paletteCache.has(src)) {
        callback(window._paletteCache.get(src));
        return;
      }

      const canvas = document.createElement('canvas');
      const ctx = canvas.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;

      const size = 48;
      canvas.width = size;
      canvas.height = size;

      const sampleAndCluster = (img) => {
        try {
          ctx.drawImage(img, 0, 0, size, size);
          const data = ctx.getImageData(0, 0, size, size).data;
          const buckets = {};

          for (let i = 0; i < data.length; i += 4) {
            const r = data[i];
            const g = data[i + 1];
            const b = data[i + 2];
            const a = data[i + 3];
            if (a < 128) continue;

            const max = Math.max(r, g, b);
            const min = Math.min(r, g, b);
            const diff = max - min;
            const lum = (r * 299 + g * 587 + b * 114) / 1000;

            // Skip pure letterbox black & blown white
            if (lum < 16 || lum > 245) continue;

            const qr = Math.round(r / 20) * 20;
            const qg = Math.round(g / 20) * 20;
            const qb = Math.round(b / 20) * 20;
            const key = `${qr},${qg},${qb}`;

            const sat = max === 0 ? 0 : diff / max;
            // Reward rich cinematic saturation & balanced lightness
            const score = (1 + sat * 2.5) * (0.6 + Math.sin((lum / 255) * Math.PI) * 0.4);

            if (!buckets[key]) {
              buckets[key] = { r: qr, g: qg, b: qb, count: 0, sat, lum };
            }
            buckets[key].count += score;
          }

          const sorted = Object.values(buckets).sort((a, b) => b.count - a.count);
          if (sorted.length === 0) {
            const fallback = ['#e2f952', '#141418', '#38bdf8', '#f97316', '#a3e635'];
            window._paletteCache.set(src, fallback);
            callback(fallback);
            return;
          }

          const palette = [];
          const dist = (c1, c2) => Math.hypot(c1.r - c2.r, c1.g - c2.g, c1.b - c2.b);

          // 1. Prime vibrant accent
          const vibrantCandidates = sorted.slice(0, 12).sort((a, b) => (b.sat * 2 + b.count * 0.02) - (a.sat * 2 + a.count * 0.02));
          const primary = vibrantCandidates[0] || sorted[0];
          palette.push(rgbToHex(primary.r, primary.g, primary.b));

          // 2-5. Pick distinct hue/tonal variations across the spectrum
          for (const item of sorted) {
            if (palette.length >= 5) break;
            const candidateRgb = { r: item.r, g: item.g, b: item.b };
            const isDistinct = palette.every(hex => {
              const exRgb = hexToRgb(hex);
              return exRgb && dist(candidateRgb, exRgb) > 40;
            });
            if (isDistinct) {
              palette.push(rgbToHex(item.r, item.g, item.b));
            }
          }

          // Pad if frame was monochromatic
          while (palette.length < 5) {
            const p0 = hexToRgb(palette[0]);
            const shift = palette.length * 45;
            palette.push(rgbToHex((p0.r + shift) % 255, (p0.g + shift * 2) % 255, (p0.b + shift * 3) % 255));
          }

          window._paletteCache.set(src, palette);
          callback(palette);
        } catch (err) {
          // If cross-origin tainted canvas, proxy image
          if (!img._isProxied) {
            img._isProxied = true;
            const pImg = new Image();
            pImg.crossOrigin = 'anonymous';
            pImg.onload = () => sampleAndCluster(pImg);
            pImg.src = '/api/proxy-image?url=' + encodeURIComponent(src);
          }
        }
      };

      if (typeof imgOrUrl !== 'string' && imgOrUrl.complete && imgOrUrl.naturalWidth > 0) {
        sampleAndCluster(imgOrUrl);
      } else {
        const testImg = new Image();
        testImg.crossOrigin = 'anonymous';
        testImg.onload = () => sampleAndCluster(testImg);
        testImg.onerror = () => {
          // Fallback via proxy
          const pImg = new Image();
          pImg.crossOrigin = 'anonymous';
          pImg.onload = () => sampleAndCluster(pImg);
          pImg.src = '/api/proxy-image?url=' + encodeURIComponent(src);
        };
        testImg.src = src;
      }
    };

    // Apply extracted palette across entire application UI
    window.setDynamicPalette = function(palette, label = '', isLock = false) {
      if (!palette || palette.length === 0) return;

      if (window._paletteLocked && !isLock) return;

      if (isLock) {
        window._paletteLocked = true;
        document.getElementById('resetPaletteBtn')?.classList.remove('hidden');
        window.showToast(`THEME LOCKED: ${palette[0].toUpperCase()}`);
      }

      window._currentPalette = palette;
      const primary = palette[0];
      const rgb = hexToRgb(primary);
      if (!rgb) return;

      const lum = (0.299 * rgb.r + 0.587 * rgb.g + 0.114 * rgb.b) / 255;
      const contrastText = lum > 0.45 ? '#000000' : '#ffffff';

      const root = document.documentElement;
      root.style.setProperty('--accent-dynamic', primary);
      root.style.setProperty('--accent-contrast', contrastText);
      root.style.setProperty('--accent-secondary', palette[1] || '#ffffff');
      root.style.setProperty('--accent-dim', `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.2)`);

      palette.forEach((col, idx) => {
        root.style.setProperty(`--palette-${idx + 1}`, col);
      });

      // Update Hero Palette Bar if present
      const heroStrip = document.getElementById('heroPaletteStrip');
      const heroLabel = document.getElementById('heroPaletteLabel');
      if (heroStrip) {
        heroStrip.innerHTML = palette.map((col, idx) => `
          <button 
            type="button"
            onclick="event.stopPropagation(); window.setDynamicPalette(['${col}', ...window._currentPalette.filter(c => c !== '${col}')], '${label}', true);"
            title="Lock ${col.toUpperCase()} (Click)"
            class="w-5 sm:w-6 h-full transition-transform hover:scale-110 cursor-pointer border-r last:border-r-0 border-black dark:border-white"
            style="background-color: ${col};"
          ></button>
        `).join('');
      }

      if (heroLabel && label) {
        heroLabel.textContent = label.toUpperCase();
      }

      // Update Lightbox Palette Bar if modal is open
      const lbStrip = document.getElementById('lightboxPaletteStrip');
      const lbHexes = document.getElementById('lightboxPaletteHexes');
      if (lbStrip) {
        lbStrip.innerHTML = palette.map((col) => `
          <button 
            type="button"
            onclick="event.stopPropagation(); window.copyToClipboard('${col}');"
            title="Copy ${col.toUpperCase()}"
            class="w-6 h-full transition-transform hover:scale-110 cursor-pointer border-r last:border-r-0 border-white"
            style="background-color: ${col};"
          ></button>
        `).join('');
      }
      if (lbHexes) {
        lbHexes.textContent = palette.map(c => c.toUpperCase()).join(' • ');
      }
    };

    window.resetDynamicPalette = function() {
      window._paletteLocked = false;
      document.getElementById('resetPaletteBtn')?.classList.add('hidden');
      if (window._defaultHeroPalette) {
        window.setDynamicPalette(window._defaultHeroPalette, window._defaultHeroLabel || 'ORIGINAL STILL');
      }
      window.showToast('PALETTE UNLOCKED');
    };

    window.initHeroFramePalette = function(url, title) {
      window._defaultHeroLabel = title;
      window.extractPaletteFromImage(url, (palette) => {
        window._defaultHeroPalette = palette;
        if (!window._paletteLocked) {
          window.setDynamicPalette(palette, title);
        }
      });
    };

    window.onFrameHover = function(url, label) {
      if (window._paletteLocked) return;
      window.extractPaletteFromImage(url, (palette) => {
        window.setDynamicPalette(palette, label);
      });
    };

    window.onFrameLeave = function() {
      if (window._paletteLocked) return;
      if (window._defaultHeroPalette) {
        window.setDynamicPalette(window._defaultHeroPalette, window._defaultHeroLabel);
      }
    };

    // Auto-scan frame cards on page and bind palettes & click events
    function initFrameCards() {
      const cards = document.querySelectorAll('.frame-card-container');
      cards.forEach(card => {
        const url = card.getAttribute('data-frame-url');
        const title = card.getAttribute('data-frame-title') || 'CINEMA STILL';
        const strip = card.querySelector('[data-palette-strip]');
        const img = card.querySelector('.frame-img');

        if (url && strip) {
          window.extractPaletteFromImage(img || url, (palette) => {
            const swatches = strip.querySelectorAll('.palette-swatch');
            swatches.forEach((swatch, idx) => {
              const col = palette[idx] || palette[0];
              swatch.style.backgroundColor = col;
              swatch.setAttribute('title', `Lock ${col.toUpperCase()} (Click to copy)`);
              swatch.onclick = (e) => {
                e.stopPropagation();
                window.copyToClipboard(col);
                window.setDynamicPalette([col, ...palette.filter(c => c !== col)], title, true);
              };
            });
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFrameCards);
    } else {
      initFrameCards();
    }

    // Lightbox modal logic
    const lightboxModal = document.getElementById('lightboxModal');
    const closeLightboxBtn = document.getElementById('closeLightboxBtn');
    const lightboxLockBtn = document.getElementById('lightboxLockBtn');
    let currentLightboxUrl = '';
    let currentLightboxPalette = null;

    window.showLightbox = function(url, title, time) {
      currentLightboxUrl = url;
      document.getElementById('lightboxImg').src = url;
      document.getElementById('lightboxTitle').textContent = title;
      document.getElementById('lightboxTime').textContent = `⏱ TIMESTAMP: ${time}`;
      
      window.extractPaletteFromImage(url, (palette) => {
        currentLightboxPalette = palette;
        window.setDynamicPalette(palette, title, false);
      });

      lightboxModal?.classList.remove('hidden');
    };

    lightboxLockBtn?.addEventListener('click', () => {
      if (currentLightboxPalette) {
        window.setDynamicPalette(currentLightboxPalette, document.getElementById('lightboxTitle').textContent, true);
      }
    });

    function hideLightbox() {
      lightboxModal?.classList.add('hidden');
      if (!window._paletteLocked && window._defaultHeroPalette) {
        window.setDynamicPalette(window._defaultHeroPalette, window._defaultHeroLabel);
      }
    }
    closeLightboxBtn?.addEventListener('click', hideLightbox);
    lightboxModal?.addEventListener('click', (e) => {
      if (e.target === lightboxModal) hideLightbox();
    });

    document.getElementById('lightboxCopyBtn')?.addEventListener('click', () => {
      if (currentLightboxUrl) {
        window.copyToClipboard(currentLightboxUrl);
      }
    });

    // Global keyboard shortcuts
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hideLightbox();
        hideUploadModal();
        document.getElementById('searchDropdown')?.classList.add('hidden');
      }
    });

    // Upload modal logic
    const uploadModal = document.getElementById('uploadModal');
    const openUploadBtn = document.getElementById('openUploadBtn');
    const closeUploadModalBtn = document.getElementById('closeUploadModalBtn');
    const cancelUploadBtn = document.getElementById('cancelUploadBtn');
    const uploadForm = document.getElementById('uploadForm');

    window.openUploadWithMovie = function(tmdbId) {
      const idInput = document.getElementById('modalTmdbId');
      if (idInput && tmdbId) idInput.value = tmdbId;
      uploadModal?.classList.remove('hidden');
    };

    openUploadBtn?.addEventListener('click', () => {
      uploadModal?.classList.remove('hidden');
    });

    function hideUploadModal() {
      uploadModal?.classList.add('hidden');
    }
    closeUploadModalBtn?.addEventListener('click', hideUploadModal);
    cancelUploadBtn?.addEventListener('click', hideUploadModal);

    uploadForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('submitUploadBtn');
      const btnText = document.getElementById('uploadBtnText');
      const spinner = document.getElementById('uploadSpinner');

      const formData = new FormData(uploadForm);
      btnText.textContent = 'STREAMING...';
      spinner.classList.remove('hidden');
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/upload', {
          method: 'POST',
          body: formData
        });
        const data = await res.json();
        
        if (res.ok && data.status === 'success') {
          window.showToast('FRAME PINNED TO ARCHIVE');
          hideUploadModal();
          uploadForm.reset();
          setTimeout(() => window.location.reload(), 1000);
        } else {
          alert('Upload failed: ' + (data.message || 'Unknown error'));
        }
      } catch (err) {
        alert('Upload failed: ' + err.message);
      } finally {
        btnText.textContent = 'UPLOAD & PIN';
        spinner.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });

    // Live Autocomplete (Poster + Title + Year ONLY)
    const searchInput = document.getElementById('globalSearchInput');
    const searchDropdown = document.getElementById('searchDropdown');
    let searchDebounce = null;

    searchInput?.addEventListener('input', (e) => {
      clearTimeout(searchDebounce);
      const query = e.target.value.trim();

      if (query.length < 2) {
        searchDropdown.classList.add('hidden');
        searchDropdown.innerHTML = '';
        return;
      }

      searchDebounce = setTimeout(async () => {
        try {
          const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
          const data = await res.json();

          if (data.results && data.results.length > 0) {
            let typoHeader = '';
            if (data.topMatch && data.topMatch.toLowerCase() !== query.toLowerCase()) {
              typoHeader = `
                <div class="px-3 py-1.5 bg-dynamic-accent border-2 border-black font-mono font-black text-[11px] uppercase mb-1">
                  [ AUTO-MATCH: ${data.topMatch} ]
                </div>
              `;
            }

            const listHtml = data.results.map(m => `
              <a href="/movie/${m.tmdbId}" class="flex items-center gap-3 p-2 hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors group">
                <img 
                  src="${m.posterUrl || 'https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=150&q=80'}" 
                  class="w-10 h-14 object-cover border-2 border-black dark:border-white shrink-0" 
                />
                <div class="flex-1 min-w-0">
                  <div class="font-bold text-xs uppercase tracking-tight truncate">
                    ${m.title}
                  </div>
                  <div class="font-mono text-[11px] opacity-75 mt-0.5">
                    ${m.year}
                  </div>
                </div>
              </a>
            `).join('');

            const viewAllFooter = `
              <a href="/?q=${encodeURIComponent(query)}" class="block mt-1 p-2 text-center font-mono text-xs uppercase font-black bg-black text-white dark:bg-white dark:text-black hover:bg-[var(--accent-dynamic,#e2f952)] hover:text-[var(--accent-contrast,#000000)] transition-colors">
                VIEW ALL RESULTS →
              </a>
            `;

            searchDropdown.innerHTML = typoHeader + listHtml + viewAllFooter;
            searchDropdown.classList.remove('hidden');
          } else {
            searchDropdown.innerHTML = `<div class="p-3 text-xs font-mono text-center uppercase font-bold text-zinc-500">NO TITLES FOUND</div>`;
            searchDropdown.classList.remove('hidden');
          }
        } catch (err) {
          console.error(err);
        }
      }, 250);
    });

    document.addEventListener('click', (e) => {
      if (!searchInput?.contains(e.target) && !searchDropdown?.contains(e.target)) {
        searchDropdown?.classList.add('hidden');
      }
    });
  </script>
</body>
</html>
